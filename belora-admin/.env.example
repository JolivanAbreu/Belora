# URL completa da Belora API em produção (ex.: https://belora-api.onrender.com).
# Em desenvolvimento local, deixe em branco - o vite.config.js já faz proxy
# de /api para http://localhost:3000.
VITE_API_URL=

# URL base da booking page pública (app separado - belora-booking), usada
# pelo link "Ver página de agendamento da cliente" no cabeçalho do painel.
# Em desenvolvimento local, o padrão já aponta para a porta 5174.
VITE_BOOKING_URL=

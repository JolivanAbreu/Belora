# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados
DATABASE_URL=postgres://belora:belora@localhost:5432/belora_dev

# Autenticação
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=troque-este-valor-tambem
JWT_REFRESH_EXPIRES_IN=30d

# CORS - lista de origens permitidas, separadas por vírgula (produção).
# Deixe vazio em desenvolvimento para liberar qualquer origem.
ALLOWED_ORIGINS=

# Integrações (placeholders - ver Documento de Arquitetura)
WHATSAPP_PROVIDER=console
EVOLUTION_API_URL=
EVOLUTION_API_INSTANCE=
EVOLUTION_API_KEY=
# URL pública da booking page (belora-booking), usada para montar o link
# de cancelamento (RF-34) enviado nas mensagens de WhatsApp.
PUBLIC_BOOKING_URL=http://localhost:5174
PAYMENT_GATEWAY_KEY=
SENTRY_DSN=

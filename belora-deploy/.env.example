# Segredos fortes - gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# URL pública pela qual o painel admin e a booking page vão acessar a API
# (ex.: https://api.seudominio.com, ou http://SEU_IP:3000 se ainda não tiver
# domínio configurado).
PUBLIC_API_URL=

# Origens permitidas para CORS, separadas por vírgula (ex.: as URLs públicas
# do painel admin e da booking page). Deixe vazio para liberar qualquer
# origem (não recomendado além do teste inicial).
ALLOWED_ORIGINS=
